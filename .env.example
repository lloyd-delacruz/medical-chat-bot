# Required secrets
PINECONE_API_KEY=your-pinecone-key
OPENAI_API_KEY=your-openai-key

# Index / embeddings
INDEX_NAME=medical-chatbot
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# LLM (use gpt-4o-mini for cheaper runs)
LLM_MODEL=gpt-4.1

# Chunking / retrieval
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_K=4

# Data sources
DATA_DIR=data/
ENABLE_CURATED=true
ENABLE_DROPIN=true
ENABLE_WEB=true

# Pinecone serverless location
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
